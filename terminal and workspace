import React, { useMemo, useState } from 'react';
import {
  Candle,
  CandleColors,
  ChartLayerState,
  EconomicNewsEvent,
  IntermarketSnapshot,
  LEVERAGE_OPTIONS,
  PaperPosition,
  RiskSettings,
  SymbolAnalysis,
  SymbolId,
  ThemeId,
  Timeframe,
  TradeSetup,
} from '../types/trading';
import { isMarketOpen, MarketStore, SYMBOL_LIST } from '../engine/marketData';
import { calculatePositionSize } from '../engine/riskAndBacktest';
import { InstitutionalChart } from './InstitutionalChart';
import { BrainCircuit, Flame, Lock, Play, ShieldAlert, Table2, TrendingDown, TrendingUp } from 'lucide-react';

interface TerminalWorkspaceProps {
  store: MarketStore;
  selectedSymbol: SymbolId;
  onSelectSymbol: (sym: SymbolId) => void;
  timeframe: Timeframe;
  onTimeframeChange: (tf: Timeframe) => void;
  chartLayers: ChartLayerState;
  onToggleChartLayer: (key: keyof ChartLayerState) => void;
  analyses: Record<SymbolId, SymbolAnalysis>;
  rankedSetups: TradeSetup[];
  top3Ids: Set<string>;
  botLocked: boolean;
  lockReason: string | null;
  risk: RiskSettings;
  onUpdateRisk: (patch: Partial<RiskSettings>) => void;
  openPositions: PaperPosition[];
  intermarket: IntermarketSnapshot;
  newsEvents?: EconomicNewsEvent[];
  onExecuteSetup: (setup: TradeSetup) => void;
  onClosePosition: (id: string) => void;
  onStepMarket: () => void;
  externalCandles?: Candle[] | null;
  feedSourceLabel?: string;
  theme?: ThemeId;
  candleColors?: CandleColors | null;
  onChangeCandleColors?: (colors: CandleColors | null) => void;
  todayTradesCount?: number;
  todayRealizedPnl?: number;
  onOpenAiAnalysis?: () => void;
}

type CategoryFilter = 'ALL' | 'Crypto' | 'Forex' | 'Commodities' | 'Indices';

function getHeatmapColors(changePct: number): string {
  if (changePct >= 1.2) return 'bg-emerald-500/30 border-emerald-400/50 text-emerald-100';
  if (changePct >= 0.35) return 'bg-emerald-500/18 border-emerald-500/35 text-emerald-200';
  if (changePct > 0.03) return 'bg-emerald-500/10 border-emerald-500/25 text-emerald-300';
  if (changePct <= -1.2) return 'bg-rose-500/30 border-rose-400/50 text-rose-100';
  if (changePct <= -0.35) return 'bg-rose-500/18 border-rose-500/35 text-rose-200';
  if (changePct < -0.03) return 'bg-rose-500/10 border-rose-500/25 text-rose-300';
  return 'bg-[var(--bg-inset)] border-[var(--border-hairline)] text-slate-300';
}

export const TerminalWorkspace: React.FC<TerminalWorkspaceProps> = ({
  store,
  selectedSymbol,
  onSelectSymbol,
  timeframe,
  onTimeframeChange,
  chartLayers,
  onToggleChartLayer,
  analyses,
  rankedSetups,
  top3Ids,
  botLocked,
  lockReason,
  risk,
  onUpdateRisk,
  openPositions,
  intermarket,
  newsEvents = [],
  onExecuteSetup,
  onClosePosition,
  onStepMarket,
  externalCandles,
  feedSourceLabel,
  theme = 'obsidian_gold',
  candleColors,
  onChangeCandleColors,
  todayTradesCount = 0,
  todayRealizedPnl = 0,
  onOpenAiAnalysis,
}) => {
  const [catFilter, setCatFilter] = useState<CategoryFilter>('ALL');
  const [bottomView, setBottomView] = useState<'scanner' | 'heatmap'>('scanner');

  const activeAnalysis = analyses[selectedSymbol];
  const activeSetup = rankedSetups.find((s) => s.symbol === selectedSymbol) ?? activeAnalysis.bestSetup;
  const sizing = activeSetup ? calculatePositionSize(activeSetup, risk) : null;
  const dec = activeAnalysis.meta.decimals;
  const activeMarketStatus = isMarketOpen(selectedSymbol);

  const usEvents = newsEvents.filter((e) => e.currency === 'USD');
  const activeUsBlackout = usEvents.find((e) => e.inBlackout);
  const nextUsEvent =
    activeUsBlackout ??
    usEvents.find((e) => e.minutesUntil >= 0 && e.impact === 'HIGH') ??
    usEvents.find((e) => e.minutesUntil >= 0) ??
    usEvents[usEvents.length - 1];

  const visibleSymbols = useMemo(() => {
    return SYMBOL_LIST.filter((sym) => {
      const cat = analyses[sym].meta.category;
      if (catFilter === 'ALL') return true;
      if (catFilter === 'Commodities') return cat === 'Metals' || cat === 'Energy';
      return cat === catFilter;
    });
  }, [analyses, catFilter]);

  const heatmapList = useMemo(() => {
    return visibleSymbols
      .map((sym) => analyses[sym])
      .sort((a, b) => b.changePct - a.changePct);
  }, [visibleSymbols, analyses]);

  const unrealizedTotal = openPositions.reduce((acc, p) => acc + p.unrealizedPnl, 0);
  const liveEquity = risk.accountBalance + unrealizedTotal;
  const usedMargin = openPositions.reduce((acc, p) => acc + (p.marginUsed ?? 0), 0);
  const freeMargin = Math.max(0, liveEquity - usedMargin);
  const initialPaperCapital = 50000;
  const netSinceStart = liveEquity - initialPaperCapital;

  return (
    <div className="space-y-5">
      {/* Paper Trading Capital & Equity Bar (Visible on Mobile & Desktop inside Terminal) */}
      <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
        <div className="border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg px-3.5 py-2.5">
          <div className="text-[11px] text-slate-400">Initial Capital</div>
          <div className="text-sm font-mono font-semibold text-slate-100 tabular-nums mt-0.5">
            ${initialPaperCapital.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
          </div>
        </div>
        <div className="border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg px-3.5 py-2.5">
          <div className="text-[11px] text-slate-400">Paper Balance</div>
          <div className="text-sm font-mono font-semibold text-[var(--accent-text)] tabular-nums mt-0.5">
            ${risk.accountBalance.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
          </div>
        </div>
        <div className="border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg px-3.5 py-2.5">
          <div className="text-[11px] text-slate-400">Live Equity</div>
          <div className={`text-sm font-mono font-semibold tabular-nums mt-0.5 ${netSinceStart >= 0 ? 'text-emerald-400' : 'text-rose-400'}`}>
            ${liveEquity.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
          </div>
        </div>
        <div className="border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg px-3.5 py-2.5">
          <div className="text-[11px] text-slate-400">Today P&amp;L</div>
          <div className={`text-sm font-mono font-semibold tabular-nums mt-0.5 ${todayRealizedPnl + unrealizedTotal >= 0 ? 'text-emerald-400' : 'text-rose-400'}`}>
            {todayRealizedPnl + unrealizedTotal >= 0 ? '+' : ''}$
            {(todayRealizedPnl + unrealizedTotal).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
          </div>
        </div>
        <div className="border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg px-3.5 py-2.5">
          <div className="text-[11px] text-slate-400">Free Margin ({risk.leverage ?? 20}x)</div>
          <div className="text-sm font-mono font-semibold text-slate-200 tabular-nums mt-0.5">
            ${freeMargin.toLocaleString(undefined, { maximumFractionDigits: 0 })}
            {usedMargin > 0 && (
              <span className="text-[10px] text-slate-400 font-normal ml-1">(${usedMargin.toFixed(0)} used)</span>
            )}
          </div>
        </div>
        <div className="border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg px-3.5 py-2.5">
          <div className="text-[11px] text-slate-400">Daily Trade Cap</div>
          <div className={`text-sm font-mono font-semibold tabular-nums mt-0.5 ${todayTradesCount >= 3 ? 'text-amber-400' : 'text-emerald-400'}`}>
            {todayTradesCount} / 3 <span className="text-[10px] text-slate-400 font-normal">All Mkts</span>
          </div>
        </div>
      </div>

      {/* Compact Instrument Category & Macro Context Bar */}
      <div className="space-y-2.5 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg px-4 py-2.5">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <div className="flex flex-wrap items-center gap-1 bg-[var(--bg-inset)] p-0.5 rounded border border-[var(--border-hairline)] text-[11px] font-mono">
            {(
              [
                { id: 'ALL', label: `All (${SYMBOL_LIST.length})` },
                { id: 'Crypto', label: 'Crypto 24/7 (5)' },
                { id: 'Forex', label: 'Forex (4)' },
                { id: 'Commodities', label: 'Metals & Oil (4)' },
                { id: 'Indices', label: 'Indices (3)' },
              ] as { id: CategoryFilter; label: string }[]
            ).map((c) => (
              <button
                key={c.id}
                type="button"
                onClick={() => setCatFilter(c.id)}
                className={`px-2 py-1 rounded transition-colors whitespace-nowrap shrink-0 ${
                  catFilter === c.id
                    ? 'bg-[var(--accent)] text-[var(--accent-fg)] font-semibold'
                    : 'text-slate-400 hover:text-slate-200'
                }`}
              >
                {c.label}
              </button>
            ))}
          </div>

          <div className="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-400">
            <span>
              Macro:{' '}
              <span
                className={
                  intermarket.regime === 'RISK_ON'
                    ? 'text-emerald-400 font-semibold'
                    : intermarket.regime === 'RISK_OFF'
                      ? 'text-rose-400 font-semibold'
                      : 'text-amber-400 font-semibold'
                }
              >
                {intermarket.regime.replace('_', ' ')}
              </span>
            </span>
            <span aria-hidden="true">·</span>
            <span>
              DXY{' '}
              <span className="text-slate-200">
                {intermarket.assets.find((a) => a.id === 'DXY')?.price.toFixed(2)}
              </span>
            </span>
            {nextUsEvent && (
              <>
                <span aria-hidden="true">·</span>
                <span
                  className={activeUsBlackout ? 'text-rose-400 font-semibold' : 'text-slate-300'}
                  title={nextUsEvent.title}
                >
                  US News: {nextUsEvent.title.split(' ').slice(0, 3).join(' ')} ({nextUsEvent.timeGmt} GMT)
                </span>
              </>
            )}
            <span aria-hidden="true">·</span>
            <span
              className={todayTradesCount >= 3 ? 'text-amber-400 font-semibold' : 'text-emerald-400 font-semibold'}
              title="Strict max 3 trades/day across ALL Forex, Metals, Crypto, Oil & Indices combined"
            >
              Daily Cap: {todayTradesCount}/3 All Markets
            </span>
            <button
              onClick={onStepMarket}
              className="px-2.5 py-1 bg-[var(--bg-elevated)] hover:brightness-110 border border-[var(--border-strong)] text-slate-200 rounded font-sans text-xs transition-colors whitespace-nowrap shrink-0"
            >
              Simulate Next 15m Bar
            </button>
          </div>
        </div>

        <div className="flex flex-wrap items-center gap-1.5">
          {visibleSymbols.map((sym) => {
            const a = analyses[sym];
            const setup = rankedSetups.find((s) => s.symbol === sym);
            const isTop3 = setup ? top3Ids.has(setup.id) : false;
            const isSelected = sym === selectedSymbol;
            const open = a.marketOpen ?? isMarketOpen(sym).open;
            return (
              <button
                key={sym}
                onClick={() => onSelectSymbol(sym)}
                title={`${sym} (${a.meta.category}) · ${open ? 'Market Live' : 'Market Closed'}`}
                className={`inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded text-xs font-mono transition-colors border whitespace-nowrap shrink-0 ${
                  isSelected
                    ? 'bg-[var(--accent-soft)] border-[var(--accent-border)] text-[var(--accent-text)] font-semibold'
                    : isTop3
                      ? 'bg-emerald-500/10 border-emerald-500/35 text-emerald-300 hover:bg-emerald-500/15'
                      : 'bg-[var(--bg-inset)] border-[var(--border-hairline)] text-slate-400 hover:text-slate-200'
                }`}
              >
                <span className={`w-1.5 h-1.5 rounded-full ${open ? 'bg-emerald-400' : 'bg-amber-400/75'}`} />
                <span>{sym}</span>
                <span className="text-[11px] opacity-80">{a.bestSetup?.score ?? 0}</span>
              </button>
            );
          })}
        </div>
      </div>

      {/* Bot Daily Lock Banner (if active) */}
      {botLocked && lockReason && (
        <div className="flex items-center justify-between gap-4 border border-amber-500/40 bg-amber-500/10 rounded-lg px-4 py-2.5 text-xs text-amber-200">
          <div className="flex items-center gap-2">
            <Lock className="w-4 h-4 text-amber-400 shrink-0" />
            <span>{lockReason}</span>
          </div>
          <span className="font-mono text-amber-300 whitespace-nowrap">PAPER LOCK ACTIVE</span>
        </div>
      )}

      {/* Primary Split: Interactive Chart (8 cols) + Confluence & Execution Inspector (4 cols) */}
      <div className="grid grid-cols-1 xl:grid-cols-12 gap-5 items-start">
        <div className="xl:col-span-8 min-w-0">
          <InstitutionalChart
            store={store}
            analysis={activeAnalysis}
            timeframe={timeframe}
            onTimeframeChange={onTimeframeChange}
            layers={chartLayers}
            onToggleLayer={onToggleChartLayer}
            activeSetup={activeSetup}
            externalCandles={externalCandles}
            feedSourceLabel={feedSourceLabel}
            theme={theme}
            candleColors={candleColors}
            onChangeCandleColors={onChangeCandleColors}
          />
        </div>

        {/* Right Confluence & Order Execution Panel */}
        <div className="xl:col-span-4 min-w-0 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg p-4 space-y-4">
          {activeSetup ? (
            <>
              <div className="flex items-start justify-between gap-2 pb-3 border-b border-slate-800/80">
                <div>
                  <div className="flex flex-wrap items-center gap-2 text-xs text-slate-400 font-mono">
                    <span>{activeSetup.strategyLabel}</span>
                    {top3Ids.has(activeSetup.id) && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span className="text-emerald-400 font-semibold">TOP-3 PICK</span>
                      </>
                    )}
                  </div>
                  <div className="flex items-center gap-2 mt-1">
                    {activeSetup.direction === 'LONG' ? (
                      <TrendingUp className="w-4 h-4 text-emerald-400" />
                    ) : (
                      <TrendingDown className="w-4 h-4 text-rose-400" />
                    )}
                    <h3 className="text-base font-display font-semibold text-slate-100">
                      {activeSetup.symbol} {activeSetup.direction}
                    </h3>
                  </div>
                  {activeAnalysis.htfBiasSummary && (
                    <div className="mt-1 text-[10.5px] font-mono text-slate-400">
                      {activeAnalysis.htfBiasSummary.label}
                    </div>
                  )}
                </div>
                <div className="text-right font-mono">
                  <div className="text-[11px] text-slate-400">Confluence</div>
                  <div
                    className={`text-xl font-bold tabular-nums ${
                      activeSetup.score >= 72
                        ? 'text-emerald-400'
                        : activeSetup.score >= 58
                          ? 'text-blue-300'
                          : 'text-amber-300'
                    }`}
                  >
                    {activeSetup.score}/100
                  </div>
                </div>
              </div>

              {/* 8-Pillar Confluence Breakdown */}
              <div className="space-y-1.5 text-xs">
                {[
                  { label: 'SMC Structure (BOS/OB/FVG)', val: activeSetup.breakdown.smcStructure, max: 20 },
                  { label: 'Zone + Candle Confirmation', val: activeSetup.breakdown.zoneAndCandle, max: 15 },
                  { label: 'Fib 0.618–0.786 OTE Zone', val: activeSetup.breakdown.fibOTE, max: 15 },
                  { label: 'Higher-TF Trend Alignment (1D/4H)', val: activeSetup.breakdown.mtfH4Bias, max: 15 },
                  { label: 'Session / Liquidity Timing', val: activeSetup.breakdown.sessionKillzone, max: 10 },
                  { label: 'Volume Profile & VWAP', val: activeSetup.breakdown.volumeVwAp, max: 10 },
                  { label: 'Intermarket Macro Regime', val: activeSetup.breakdown.intermarketRegime, max: 10 },
                  { label: 'COT & Retail Sentiment', val: activeSetup.breakdown.sentimentCot, max: 5 },
                ].map((row) => (
                  <div key={row.label} className="space-y-0.5">
                    <div className="flex items-center justify-between text-[11px]">
                      <span className="text-slate-400">{row.label}</span>
                      <span className="font-mono text-slate-200 tabular-nums">
                        {row.val}/{row.max}
                      </span>
                    </div>
                    <div className="w-full h-1 bg-[var(--bg-inset)] rounded overflow-hidden">
                      <div
                        className="h-full bg-[var(--accent)]"
                        style={{ width: `${Math.round((row.val / row.max) * 100)}%` }}
                      />
                    </div>
                  </div>
                ))}
              </div>

              {/* Structural Telemetry + Empirical Backtest Snapshot */}
              <div className="grid grid-cols-2 gap-2 pt-3 border-t border-[var(--border-hairline)] text-xs font-mono tabular-nums">
                <div className="p-2 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)]">
                  <div className="text-[10px] text-slate-500 font-sans">Wyckoff Phase</div>
                  <div className="text-slate-200 mt-0.5">{activeAnalysis.wyckoff.phase}</div>
                </div>
                <div className="p-2 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)]">
                  <div className="text-[10px] text-slate-500 font-sans">
                    Validated Acc (&gt;{risk.minAccuracyPct ?? 65}%)
                  </div>
                  <div
                    className={`mt-0.5 font-semibold ${
                      activeSetup.mlFilter.decision === 'PASS' ? 'text-emerald-400' : 'text-rose-400'
                    }`}
                  >
                    {activeSetup.mlFilter.decision} ({(activeSetup.mlFilter.probability * 100).toFixed(1)}%)
                  </div>
                </div>
                {activeSetup.backtestStats && (() => {
                  const bs = activeSetup.backtestStats;
                  const negEdge = bs.trades === 0 || bs.expectancy <= 0 || bs.sharpeRatio <= 0 || bs.profitFactor < 1.0;
                  const isLowSample = bs.lowSample ?? bs.trades < 20;
                  return (
                    <div className="p-2 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)]">
                      <div className="flex items-center justify-between gap-1 text-[10px] text-slate-500 font-sans">
                        <span>Backtest Edge ({bs.trades}T)</span>
                        {isLowSample && (
                          <span
                            title="Fewer than 20 historical trades — treat WR/Sharpe cautiously"
                            className="text-[9.5px] font-mono text-amber-300 font-semibold"
                          >
                            Low Sample
                          </span>
                        )}
                      </div>
                      <div className={`mt-0.5 font-semibold ${negEdge ? 'text-rose-400' : 'text-emerald-300'}`}>
                        {bs.trades === 0
                          ? '0 Trades Found'
                          : `WR ${bs.winRate.toFixed(0)}% · SR ${bs.sharpeRatio.toFixed(1)}`}
                      </div>
                      <div className="text-[10px] text-slate-400 mt-0.5">
                        Exp ${bs.expectancy.toFixed(0)} · DD -{bs.maxDrawdownPct.toFixed(1)}%
                      </div>
                    </div>
                  );
                })()}
                <div className="p-2 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)]">
                  <div className="text-[10px] text-slate-500 font-sans">1% Risk Lot &amp; Friction</div>
                  <div className="text-slate-200 mt-0.5">
                    {sizing?.lots.toFixed(2)} Lots (${sizing?.dollarRisk})
                  </div>
                  {sizing && (
                    <div className="text-[10px] text-slate-400 mt-0.5">
                      Margin ${sizing.requiredMargin.toLocaleString(undefined, { maximumFractionDigits: 0 })} @{' '}
                      {sizing.leverage}x · Cost ~${activeSetup.netCostEstimate ?? 0}
                    </div>
                  )}
                </div>
              </div>

              {/* Leverage Selector: 10x, 20x (Default), 30x, 40x, 50x */}
              <div className="p-2.5 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)] space-y-1.5">
                <div className="flex items-center justify-between text-[11px]">
                  <span className="text-slate-400">Leverage (10x–50x · Default 20x)</span>
                  <span
                    className={`font-mono font-semibold ${
                      (risk.leverage ?? 20) >= 30 ? 'text-amber-300' : 'text-[var(--accent-text)]'
                    }`}
                  >
                    {risk.leverage ?? 20}x
                  </span>
                </div>
                <div className="grid grid-cols-5 gap-1">
                  {LEVERAGE_OPTIONS.map((lev) => {
                    const active = (risk.leverage ?? 20) === lev;
                    return (
                      <button
                        key={lev}
                        type="button"
                        onClick={() => onUpdateRisk({ leverage: lev })}
                        className={`py-1 rounded text-[11px] font-mono font-semibold border transition-colors ${
                          active
                            ? 'bg-[var(--accent)] border-[var(--accent)] text-[var(--accent-fg)]'
                            : 'bg-[var(--bg-surface)] border-[var(--border-hairline)] text-slate-400 hover:text-slate-200'
                        }`}
                      >
                        {lev}x
                      </button>
                    );
                  })}
                </div>
                {(risk.leverage ?? 20) >= 30 ? (
                  <div className="text-[10px] text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded px-2 py-1 leading-snug">
                    High Leverage Risk ({risk.leverage}x): Amplifies slippage &amp; liquidation exposure on sudden spikes. Default 20x recommended.
                  </div>
                ) : (
                  <div className="text-[10px] text-slate-500">
                    20x institutional default active · 30x–50x carries elevated margin/liquidation risk.
                  </div>
                )}
              </div>

              {/* Entry / SL / TP1 / TP2 Levels */}
              <div className="grid grid-cols-4 gap-1.5 text-center font-mono text-[11px] tabular-nums">
                <div className="p-2 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)]">
                  <div className="text-slate-500">Entry</div>
                  <div className="text-[var(--accent-text)] mt-0.5">{activeSetup.entryPrice.toFixed(dec)}</div>
                </div>
                <div className="p-2 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)]">
                  <div className="text-slate-500">ATR SL</div>
                  <div className="text-rose-400 mt-0.5">{activeSetup.stopLoss.toFixed(dec)}</div>
                </div>
                <div className="p-2 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)]">
                  <div className="text-slate-500">TP1 (1R)</div>
                  <div className="text-emerald-300 mt-0.5">{activeSetup.takeProfit1.toFixed(dec)}</div>
                </div>
                <div className="p-2 rounded bg-[var(--bg-inset)] border border-[var(--border-hairline)]">
                  <div className="text-slate-500">TP2 (1:{activeSetup.riskReward})</div>
                  <div className="text-emerald-400 mt-0.5">{activeSetup.takeProfit2.toFixed(dec)}</div>
                </div>
              </div>

              {/* Guardrail Block Warnings */}
              {activeSetup.blockedReasons.length > 0 && (
                <div className="p-2.5 rounded bg-rose-500/10 border border-rose-500/35 text-[11px] text-rose-300 space-y-1">
                  <div className="flex items-center gap-1.5 font-semibold">
                    <ShieldAlert className="w-3.5 h-3.5" />
                    Risk Guardrail Blocked
                  </div>
                  {activeSetup.blockedReasons.map((r, idx) => (
                    <div key={idx}>· {r}</div>
                  ))}
                </div>
              )}

              <div className="space-y-2">
                <button
                  onClick={() => onExecuteSetup(activeSetup)}
                  disabled={!activeSetup.eligible || botLocked || !activeMarketStatus.open}
                  className="w-full flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-md transition-colors bg-[var(--accent)] hover:bg-[var(--accent-hover)] disabled:bg-slate-800 disabled:text-slate-500 text-[var(--accent-fg)]"
                >
                  <Play className="w-3.5 h-3.5" />
                  {!activeMarketStatus.open
                    ? 'Market Closed (Reopens Sun 22:00 UTC)'
                    : activeSetup.eligible && !botLocked
                      ? `Execute Paper ${activeSetup.direction} (${sizing?.lots.toFixed(2)} Lots)`
                      : 'Execution Blocked by Risk Guardrails'}
                </button>
                {onOpenAiAnalysis && (
                  <button
                    onClick={onOpenAiAnalysis}
                    className="w-full flex items-center justify-center gap-2 px-4 py-2 text-xs font-medium rounded-md transition-colors bg-[var(--bg-inset)] hover:bg-[var(--bg-elevated)] border border-[var(--border-strong)] text-[var(--accent-text)]"
                  >
                    <BrainCircuit className="w-3.5 h-3.5" />
                    Run AI Deep Quant Thesis ({selectedSymbol})
                  </button>
                )}
              </div>
            </>
          ) : (
            <div className="text-xs text-slate-500 py-10 text-center">No active setup evaluated for this symbol.</div>
          )}
        </div>
      </div>

      {/* Bottom Grid: Multi-Asset Qualitative Scanner / Heatmap + Active Paper Positions */}
      <div className="grid grid-cols-1 xl:grid-cols-12 gap-5 items-start">
        <div className="xl:col-span-7 min-w-0 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg p-4">
          <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div>
              <h3 className="text-sm font-display font-semibold text-slate-100">
                Multi-Asset Qualitative Scanner &amp; Market Heatmap
              </h3>
              <p className="text-xs text-slate-400">
                Ranks {SYMBOL_LIST.length} instruments (Forex, Crypto 24/7, Metals, Energy, Indices) strictly &gt;{risk.minAccuracyPct ?? 65}% accuracy &amp; HTF aligned.
              </p>
            </div>
            <div className="flex items-center gap-1 bg-[var(--bg-inset)] p-0.5 rounded border border-[var(--border-hairline)] text-[11px] font-mono">
              <button
                type="button"
                onClick={() => setBottomView('scanner')}
                className={`flex items-center gap-1 px-2.5 py-1 rounded transition-colors ${
                  bottomView === 'scanner'
                    ? 'bg-[var(--accent)] text-[var(--accent-fg)] font-semibold'
                    : 'text-slate-400 hover:text-slate-200'
                }`}
              >
                <Table2 className="w-3 h-3" />
                Scanner Table
              </button>
              <button
                type="button"
                onClick={() => setBottomView('heatmap')}
                className={`flex items-center gap-1 px-2.5 py-1 rounded transition-colors ${
                  bottomView === 'heatmap'
                    ? 'bg-[var(--accent)] text-[var(--accent-fg)] font-semibold'
                    : 'text-slate-400 hover:text-slate-200'
                }`}
              >
                <Flame className="w-3 h-3" />
                Crypto &amp; Heatmap
              </button>
            </div>
          </div>

          {bottomView === 'scanner' ? (
            <>
              <div className="sm:hidden text-[10.5px] font-mono text-slate-500 mb-1.5">
                Symbol pinned left · Swipe horizontally for Accuracy, RR &amp; Status →
              </div>
              <div className="w-full overflow-x-auto">
                <table className="w-full min-w-[740px] text-xs font-mono tabular-nums">
                  <thead className="bg-[var(--bg-elevated)] text-slate-400">
                    <tr>
                      <th className="sticky left-0 z-10 bg-[var(--bg-elevated)] p-2 text-left border-r border-[var(--border-hairline)]">
                        Rank / Symbol
                      </th>
                      <th className="p-2 text-left">Dir</th>
                      <th className="p-2 text-left">Strategy</th>
                      <th className="p-2 text-right">Score</th>
                      <th className="p-2 text-right">OTE</th>
                      <th className="p-2 text-right">Accuracy</th>
                      <th className="p-2 text-right">RR</th>
                      <th className="p-2 text-left">Status</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-[var(--border-hairline)]">
                    {rankedSetups
                      .filter((s) => visibleSymbols.includes(s.symbol))
                      .map((s, idx) => {
                        const isTop3 = top3Ids.has(s.id);
                        const fib = analyses[s.symbol].autoFib;
                        const open = analyses[s.symbol].marketOpen ?? true;
                        const probPct = s.mlFilter.probability * 100;
                        const passesAccuracy = s.mlFilter.decision === 'PASS' && probPct > (risk.minAccuracyPct ?? 65);
                        const isSelected = s.symbol === selectedSymbol;
                        return (
                          <tr
                            key={s.id}
                            onClick={() => onSelectSymbol(s.symbol)}
                            className={`cursor-pointer transition-colors ${
                              isSelected ? 'bg-[var(--accent-soft)]' : 'hover:bg-white/[0.03]'
                            }`}
                          >
                            <td
                              className={`sticky left-0 z-10 p-2 font-semibold text-slate-100 whitespace-nowrap border-r border-[var(--border-hairline)] ${
                                isSelected ? 'bg-[var(--bg-elevated)]' : 'bg-[var(--bg-surface)]'
                              }`}
                            >
                              <span className="inline-flex items-center gap-1.5">
                                <span className="text-[10px] text-slate-500 w-5">#{idx + 1}</span>
                                <span
                                  className={`w-1.5 h-1.5 rounded-full ${open ? 'bg-emerald-400' : 'bg-amber-400/75'}`}
                                />
                                <span>{s.symbol}</span>
                              </span>
                            </td>
                            <td className={`p-2 font-semibold ${s.direction === 'LONG' ? 'text-emerald-400' : 'text-rose-400'}`}>
                              {s.direction}
                            </td>
                            <td className="p-2 font-sans text-slate-300 whitespace-nowrap">{s.strategyLabel}</td>
                            <td className="p-2 text-right font-semibold text-[var(--accent-text)]">{s.score}</td>
                            <td
                              className={`p-2 text-right whitespace-nowrap ${
                                fib.inOTE
                                  ? 'text-[var(--accent-text)] font-semibold'
                                  : fib.invalidated
                                    ? 'text-slate-500'
                                    : 'text-slate-400'
                              }`}
                            >
                              {fib.invalidated
                                ? 'SWEPT'
                                : fib.inOTE
                                  ? 'IN OTE'
                                  : `${Math.min(100, Math.max(0, fib.currentRetracement * 100)).toFixed(0)}%`}
                            </td>
                            <td className={`p-2 text-right font-semibold ${passesAccuracy ? 'text-emerald-400' : 'text-rose-400'}`}>
                              {probPct.toFixed(0)}%
                            </td>
                            <td className="p-2 text-right text-slate-300">1:{s.riskReward}</td>
                            <td className="p-2 font-sans">
                              {isTop3 ? (
                                <span className="text-emerald-400 font-semibold whitespace-nowrap">Top-3 Selected</span>
                              ) : s.eligible ? (
                                <span className="text-slate-400 whitespace-nowrap">Standby</span>
                              ) : (
                                <span className="text-rose-400 truncate block max-w-[210px]" title={s.blockedReasons[0]}>
                                  {s.blockedReasons[0]}
                                </span>
                              )}
                            </td>
                          </tr>
                        );
                      })}
                  </tbody>
                </table>
              </div>
            </>
          ) : (
            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5">
              {heatmapList.map((item) => {
                const open = item.marketOpen ?? true;
                const score = item.bestSetup?.score ?? 0;
                const wr = item.backtestStats?.winRate ?? 0;
                return (
                  <button
                    key={item.meta.id}
                    type="button"
                    onClick={() => onSelectSymbol(item.meta.id)}
                    className={`text-left p-2.5 rounded-md border transition-transform hover:brightness-110 ${getHeatmapColors(
                      item.changePct
                    )} ${item.meta.id === selectedSymbol ? 'ring-1 ring-[var(--accent)]' : ''}`}
                  >
                    <div className="flex items-center justify-between gap-1">
                      <span className="font-mono text-xs font-bold text-slate-100">{item.meta.id}</span>
                      <span
                        className={`text-[9px] font-mono px-1.5 py-0.5 rounded ${
                          open ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/15 text-amber-300'
                        }`}
                      >
                        {item.meta.category === 'Crypto' ? '24/7' : open ? 'LIVE' : 'CLOSED'}
                      </span>
                    </div>
                    <div className="mt-1 flex items-baseline justify-between gap-1 font-mono tabular-nums">
                      <span className="text-xs font-semibold text-white">
                        {item.currentPrice.toFixed(item.meta.decimals)}
                      </span>
                      <span className={`text-xs font-bold ${item.changePct >= 0 ? 'text-emerald-300' : 'text-rose-300'}`}>
                        {item.changePct >= 0 ? '+' : ''}
                        {item.changePct.toFixed(2)}%
                      </span>
                    </div>
                    <div className="mt-1.5 pt-1 border-t border-white/10 flex items-center justify-between text-[10px] font-mono text-slate-300">
                      <span>{item.htfBiasSummary?.direction ?? item.h4Trend}</span>
                      <span>
                        S:{score} · WR:{wr.toFixed(0)}%
                      </span>
                    </div>
                  </button>
                );
              })}
            </div>
          )}
        </div>

        {/* Active Paper Positions & Smart Trade Manager */}
        <div className="xl:col-span-5 min-w-0 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg p-4">
          <div className="flex items-center justify-between mb-3">
            <div>
              <h3 className="text-sm font-display font-semibold text-slate-100">
                Open Paper Positions ({openPositions.length})
              </h3>
              <p className="text-xs text-slate-400">
                Auto-manages 1R 50% partial profits, Breakeven SL, ATR trailing, and News Auto-Exit.
              </p>
            </div>
          </div>

          {openPositions.length === 0 ? (
            <div className="p-8 text-center text-xs text-slate-500 border border-[var(--border-hairline)] rounded bg-[var(--bg-inset)]">
              No open paper positions. Select an active setup (&gt;{risk.minAccuracyPct ?? 65}% accuracy) or click &ldquo;Execute Top-3 Setups&rdquo; in the header.
            </div>
          ) : (
            <div className="space-y-3">
              {openPositions.map((pos) => (
                <div key={pos.id} className="p-3 rounded border border-[var(--border-hairline)] bg-[var(--bg-inset)] text-xs space-y-2">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-2 font-mono">
                      <span className="font-semibold text-slate-100">{pos.symbol}</span>
                      <span className={pos.direction === 'LONG' ? 'text-emerald-400' : 'text-rose-400'}>
                        {pos.direction}
                      </span>
                      <span className="text-slate-500">·</span>
                      <span className="text-slate-400">
                        {pos.lots} lots ({pos.remainingPct}%)
                        {pos.leverage ? ` · ${pos.leverage}x` : ''}
                      </span>
                    </div>
                    <div
                      className={`font-mono font-semibold tabular-nums ${
                        pos.unrealizedPnl + pos.realizedPnl >= 0 ? 'text-emerald-400' : 'text-rose-400'
                      }`}
                    >
                      {pos.unrealizedPnl + pos.realizedPnl >= 0 ? '+' : ''}$
                      {(pos.unrealizedPnl + pos.realizedPnl).toFixed(2)} ({pos.rMultiple >= 0 ? '+' : ''}
                      {pos.rMultiple.toFixed(2)}R)
                    </div>
                  </div>

                  <div className="flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-slate-400">
                    <span>
                      Entry {pos.entryPrice} · SL {pos.stopLoss} · TP2 {pos.takeProfit2}
                    </span>
                    <div className="flex items-center gap-2">
                      {pos.partialBooked && <span className="text-emerald-400">1R Booked</span>}
                      {pos.breakevenMoved && <span className="text-[var(--accent-text)]">BE Protected</span>}
                      {pos.trailingActive && <span className="text-amber-300">ATR Trail</span>}
                      <button
                        onClick={() => onClosePosition(pos.id)}
                        className="px-2 py-0.5 rounded bg-[var(--bg-elevated)] hover:brightness-110 border border-[var(--border-hairline)] text-slate-200 font-sans"
                      >
                        Close
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

