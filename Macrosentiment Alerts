import React, { useState } from 'react';
import { AlertLogItem, EconomicNewsEvent, SymbolAnalysis, SymbolId, TelegramConfig } from '../types/trading';
import { SYMBOL_LIST } from '../engine/marketData';
import { CalendarClock, Send } from 'lucide-react';

interface MacroSentimentAlertsViewProps {
  analyses: Record<SymbolId, SymbolAnalysis>;
  newsEvents?: EconomicNewsEvent[];
  telegram: TelegramConfig;
  onUpdateTelegram: (patch: Partial<TelegramConfig>) => void;
  alertLogs: AlertLogItem[];
  onSendTestTelegram: () => Promise<void>;
}

export const MacroSentimentAlertsView: React.FC<MacroSentimentAlertsViewProps> = ({
  analyses,
  newsEvents = [],
  telegram,
  onUpdateTelegram,
  alertLogs,
  onSendTestTelegram,
}) => {
  const [sending, setSending] = useState(false);

  const handleTest = async () => {
    setSending(true);
    try {
      await onSendTestTelegram();
    } finally {
      setSending(false);
    }
  };

  return (
    <div className="space-y-6">
      {/* COT Report + Retail Contrarian Sentiment + Wyckoff Cycles */}
      <div className="border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg p-5">
        <div className="mb-4">
          <h2 className="text-base font-display font-semibold text-slate-100">
            Institutional COT Positioning, Retail Contrarian Sentiment &amp; Wyckoff Cycles
          </h2>
          <p className="text-xs text-slate-400 mt-0.5">
            Tracks Hedge Fund / Commercial net contracts alongside Retail Crowd skew (contrarian fade &gt;62%) and active Wyckoff phase.
          </p>
        </div>

        {/* Mobile Card Stack (Zero Horizontal Cutoff) */}
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 md:hidden">
          {SYMBOL_LIST.map((sym) => {
            const a = analyses[sym];
            const s = a.sentiment;
            const w = a.wyckoff;
            return (
              <div
                key={`mob-${sym}`}
                className="p-3 rounded-md bg-[var(--bg-inset)] border border-[var(--border-hairline)] space-y-2 text-xs font-mono"
              >
                <div className="flex items-center justify-between gap-2">
                  <span className="font-bold text-slate-100 text-sm">{sym}</span>
                  <span
                    className={`px-2 py-0.5 rounded text-[10.5px] font-semibold border ${
                      s.contrarianSignal === 'LONG'
                        ? 'bg-emerald-500/15 border-emerald-500/35 text-emerald-300'
                        : s.contrarianSignal === 'SHORT'
                          ? 'bg-rose-500/15 border-rose-500/35 text-rose-300'
                          : 'bg-slate-800 border-slate-700 text-slate-400'
                    }`}
                  >
                    Edge: {s.contrarianSignal}
                  </span>
                </div>
                <div className="flex items-center justify-between text-[11px]">
                  <span className={w.phase === 'Markup' || w.phase === 'Accumulation' ? 'text-emerald-400 font-sans' : 'text-rose-400 font-sans'}>
                    {w.phase} ({w.confidence}%)
                  </span>
                  <span className="text-slate-300 tabular-nums">
                    COT: {s.cotNetContracts >= 0 ? '+' : ''}
                    {s.cotNetContracts.toLocaleString()}{' '}
                    <span className={s.cotWeeklyChange >= 0 ? 'text-emerald-400' : 'text-rose-400'}>
                      ({s.cotWeeklyChange >= 0 ? '+' : ''}
                      {s.cotWeeklyChange.toLocaleString()})
                    </span>
                  </span>
                </div>
                <div className="space-y-1 text-[10.5px]">
                  <div className="flex items-center justify-between text-slate-400">
                    <span>Institutional L/S</span>
                    <span className="text-slate-200">{s.cotInstitutionalLongPct}% / {s.cotInstitutionalShortPct}%</span>
                  </div>
                  <div className="w-full h-1.5 bg-rose-500/40 rounded overflow-hidden">
                    <div className="h-full bg-emerald-500" style={{ width: `${s.cotInstitutionalLongPct}%` }} />
                  </div>
                  <div className="flex items-center justify-between text-slate-400 pt-1">
                    <span>Retail Crowd L/S</span>
                    <span className="text-slate-200">{s.retailLongPct}% / {s.retailShortPct}%</span>
                  </div>
                  <div className="w-full h-1.5 bg-rose-500/40 rounded overflow-hidden">
                    <div className="h-full bg-amber-400" style={{ width: `${s.retailLongPct}%` }} />
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        {/* Desktop & Tablet Table with Sticky Instrument Column */}
        <div className="hidden md:block w-full overflow-x-auto">
          <table className="w-full min-w-[760px] text-xs font-mono tabular-nums">
            <thead className="bg-[var(--bg-elevated)] text-slate-400">
              <tr>
                <th className="sticky left-0 z-10 bg-[var(--bg-elevated)] p-2.5 text-left border-r border-[var(--border-hairline)]">
                  Instrument
                </th>
                <th className="p-2.5 text-left">Wyckoff Cycle</th>
                <th className="p-2.5 text-right">COT Net Contracts</th>
                <th className="p-2.5 text-right">Weekly Δ</th>
                <th className="p-2.5 text-left">Institutional Split (L / S)</th>
                <th className="p-2.5 text-left">Retail Crowd (L / S)</th>
                <th className="p-2.5 text-right">Contrarian Edge</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800/70">
              {SYMBOL_LIST.map((sym) => {
                const a = analyses[sym];
                const s = a.sentiment;
                const w = a.wyckoff;
                return (
                  <tr key={sym} className="hover:bg-slate-800/30">
                    <td className="sticky left-0 z-10 bg-[var(--bg-surface)] p-2.5 font-semibold text-slate-100 border-r border-[var(--border-hairline)] whitespace-nowrap">
                      {sym}
                    </td>
                    <td className="p-2.5 font-sans whitespace-nowrap">
                      <span
                        className={
                          w.phase === 'Markup' || w.phase === 'Accumulation' ? 'text-emerald-400' : 'text-rose-400'
                        }
                      >
                        {w.phase}
                      </span>
                      <span className="text-slate-500 text-[11px] ml-1.5">({w.confidence}%)</span>
                    </td>
                    <td className="p-2.5 text-right text-slate-200 whitespace-nowrap">
                      {s.cotNetContracts >= 0 ? '+' : ''}
                      {s.cotNetContracts.toLocaleString()}
                    </td>
                    <td
                      className={`p-2.5 text-right whitespace-nowrap ${s.cotWeeklyChange >= 0 ? 'text-emerald-400' : 'text-rose-400'}`}
                    >
                      {s.cotWeeklyChange >= 0 ? '+' : ''}
                      {s.cotWeeklyChange.toLocaleString()}
                    </td>
                    <td className="p-2.5 whitespace-nowrap">
                      <div className="flex items-center gap-2">
                        <div className="w-24 h-2 bg-rose-500/40 rounded overflow-hidden">
                          <div
                            className="h-full bg-emerald-500"
                            style={{ width: `${s.cotInstitutionalLongPct}%` }}
                          />
                        </div>
                        <span className="text-slate-300">
                          {s.cotInstitutionalLongPct}% / {s.cotInstitutionalShortPct}%
                        </span>
                      </div>
                    </td>
                    <td className="p-2.5 whitespace-nowrap">
                      <div className="flex items-center gap-2">
                        <div className="w-24 h-2 bg-rose-500/40 rounded overflow-hidden">
                          <div className="h-full bg-amber-400" style={{ width: `${s.retailLongPct}%` }} />
                        </div>
                        <span className="text-slate-300">
                          {s.retailLongPct}% / {s.retailShortPct}%
                        </span>
                      </div>
                    </td>
                    <td className="p-2.5 text-right whitespace-nowrap">
                      <span
                        className={
                          s.contrarianSignal === 'LONG'
                            ? 'text-emerald-400 font-semibold'
                            : s.contrarianSignal === 'SHORT'
                              ? 'text-rose-400 font-semibold'
                              : 'text-slate-500'
                        }
                      >
                        {s.contrarianSignal}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      {/* Important USA Economic News Schedule */}
      {newsEvents.length > 0 && (
        <div className="border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg p-5 overflow-x-auto">
          <div className="flex flex-wrap items-center justify-between gap-2 mb-4">
            <div className="flex items-center gap-2">
              <CalendarClock className="w-4 h-4 text-[var(--accent-text)]" />
              <div>
                <h2 className="text-base font-display font-semibold text-slate-100">
                  Important USA Economic News Calendar (USD High &amp; Medium Impact)
                </h2>
                <p className="text-xs text-slate-400 mt-0.5">
                  Tracks NFP, CPI, PPI, Core PCE, FOMC, GDP, Retail Sales, ISM PMI, JOLTS, Jobless Claims, UoM &amp; EIA Oil releases with automatic ±30m blackout protection.
                </p>
              </div>
            </div>
            <span className="text-[11px] font-mono text-slate-400">
              {newsEvents.filter((e) => e.currency === 'USD').length} US Releases Tracked
            </span>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
            {newsEvents
              .filter((ev) => ev.currency === 'USD')
              .map((ev) => (
                <div
                  key={ev.id}
                  className={`p-3 rounded-md border text-xs space-y-1.5 ${
                    ev.inBlackout
                      ? 'bg-rose-500/10 border-rose-500/40'
                      : 'bg-[var(--bg-inset)] border-[var(--border-hairline)]'
                  }`}
                >
                  <div className="flex items-center justify-between gap-2 font-mono">
                    <span className="text-slate-100 font-semibold">{ev.timeGmt} GMT</span>
                    <div className="flex items-center gap-1.5">
                      {ev.schedule && <span className="text-[10px] text-slate-400">{ev.schedule}</span>}
                      <span
                        className={`px-1.5 py-0.5 rounded text-[10px] font-semibold ${
                          ev.impact === 'HIGH'
                            ? 'bg-rose-500/20 text-rose-300 border border-rose-500/35'
                            : 'bg-amber-500/15 text-amber-300 border border-amber-500/30'
                        }`}
                      >
                        {ev.impact}
                      </span>
                    </div>
                  </div>
                  <div className="font-medium text-slate-100">{ev.title}</div>
                  {ev.notes && <p className="text-[11px] text-slate-400 leading-relaxed">{ev.notes}</p>}
                  <div className="flex items-center justify-between text-[10.5px] font-mono pt-1 border-t border-[var(--border-hairline)]">
                    <span className="text-slate-500 truncate">
                      {(ev.affectedSymbols ?? []).slice(0, 4).join(' · ')}
                    </span>
                    <span className={ev.inBlackout ? 'text-rose-400 font-semibold' : 'text-slate-400'}>
                      {(() => {
                        const mins = Number.isFinite(ev.minutesUntil) ? ev.minutesUntil : 0;
                        return ev.inBlackout ? 'BLACKOUT' : mins >= 0 ? `T-${mins}m` : `T+${Math.abs(mins)}m`;
                      })()}
                    </span>
                  </div>
                </div>
              ))}
          </div>
        </div>
      )}

      {/* Telegram Alert Bot Config & Dispatch Log */}
      <div className="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
        <div className="xl:col-span-5 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg p-5">
          <div className="flex items-center justify-between gap-3 mb-4">
            <div>
              <h2 className="text-base font-display font-semibold text-slate-100">Telegram Trade Alerts</h2>
              <p className="text-xs text-slate-400 mt-0.5">
                Real-time trade entries, 1R partials, exits, and daily lock notifications.
              </p>
            </div>
            <button
              onClick={() => onUpdateTelegram({ enabled: !telegram.enabled })}
              className={`px-3 py-1 text-xs font-medium rounded border transition-colors whitespace-nowrap shrink-0 ${
                telegram.enabled
                  ? 'bg-emerald-600/20 text-emerald-300 border-emerald-500/40'
                  : 'bg-[var(--bg-elevated)] text-slate-400 border-[var(--border-strong)]'
              }`}
            >
              {telegram.enabled ? 'Enabled' : 'Paused'}
            </button>
          </div>

          <div className="space-y-3">
            <label className="block">
              <span className="text-xs text-slate-400">Telegram Bot Token (Optional for live webhook)</span>
              <input
                type="password"
                placeholder="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
                value={telegram.botToken}
                onChange={(e) => onUpdateTelegram({ botToken: e.target.value })}
                className="mt-1 w-full bg-[var(--bg-inset)] border border-[var(--border-strong)] rounded px-3 py-2 text-xs font-mono text-slate-100"
              />
            </label>
            <label className="block">
              <span className="text-xs text-slate-400">Target Chat / Channel ID</span>
              <input
                type="text"
                placeholder="-1001234567890"
                value={telegram.chatId}
                onChange={(e) => onUpdateTelegram({ chatId: e.target.value })}
                className="mt-1 w-full bg-[var(--bg-inset)] border border-[var(--border-strong)] rounded px-3 py-2 text-xs font-mono text-slate-100"
              />
            </label>

            <div className="grid grid-cols-2 gap-2 pt-2 text-xs text-slate-300">
              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={telegram.alertOnEntry}
                  onChange={(e) => onUpdateTelegram({ alertOnEntry: e.target.checked })}
                />
                Trade Entry
              </label>
              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={telegram.alertOnPartial}
                  onChange={(e) => onUpdateTelegram({ alertOnPartial: e.target.checked })}
                />
                1R Partial + BE
              </label>
              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={telegram.alertOnExit}
                  onChange={(e) => onUpdateTelegram({ alertOnExit: e.target.checked })}
                />
                SL / TP / News Exit
              </label>
              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={telegram.alertOnKillSwitch}
                  onChange={(e) => onUpdateTelegram({ alertOnKillSwitch: e.target.checked })}
                />
                Daily Limit Lock
              </label>
            </div>

            <button
              onClick={handleTest}
              disabled={sending}
              className="w-full mt-2 flex items-center justify-center gap-2 px-4 py-2 text-xs font-semibold bg-[var(--accent)] hover:bg-[var(--accent-hover)] disabled:opacity-60 text-[var(--accent-fg)] rounded-md transition-colors whitespace-nowrap"
            >
              <Send className="w-3.5 h-3.5" />
              {sending ? 'Dispatching Alert...' : 'Send Test Trade Alert'}
            </button>
          </div>
        </div>

        {/* Live Dispatch Log */}
        <div className="xl:col-span-7 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-lg p-5">
          <h3 className="text-sm font-display font-semibold text-slate-100 mb-3">Alert Dispatch Feed</h3>
          <div className="space-y-2.5 max-h-80 overflow-y-auto">
            {alertLogs.length === 0 ? (
              <div className="p-6 text-center text-xs text-slate-500 border border-[var(--border-hairline)] rounded bg-[var(--bg-inset)]">
                No alerts dispatched yet. Execute a paper trade or send a test Telegram alert.
              </div>
            ) : (
              alertLogs.map((log) => (
                <div key={log.id} className="p-3 rounded border border-[var(--border-hairline)] bg-[var(--bg-inset)] text-xs">
                  <div className="flex items-center justify-between text-slate-400 font-mono">
                    <span className="text-[var(--accent-text)] font-semibold">{log.title}</span>
                    <span>
                      {new Date(log.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}{' '}
                      · {log.delivered ? 'Telegram Sent' : 'Logged Locally'}
                    </span>
                  </div>
                  <pre className="mt-1.5 text-[11px] font-mono text-slate-300 whitespace-pre-wrap leading-relaxed">
                    {log.message}
                  </pre>
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </div>
  );
};
